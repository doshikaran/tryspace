{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.tryscape.invalid/v1/scene_spec.schema.json",
  "title": "SceneSpec v1.0.0",
  "description": "Canonical spatial scene (technical-spec S06.2/S06.3). JSON Schema checks shape only; collision, route, containment and catalog rules are semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "scene_id", "project_id", "scenario_pack_id", "scenario_pack_version",
    "catalog_version", "revision", "room", "entities", "routes", "active_route_id",
    "assumptions", "provenance", "measurement_sources"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version_1_0_0"},
    "scene_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "project_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "scenario_pack_id": {"enum": ["moving_day"]},
    "scenario_pack_version": {"$ref": "common.schema.json#/$defs/semver"},
    "catalog_version": {"$ref": "common.schema.json#/$defs/semver"},
    "revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "room": {"$ref": "#/$defs/room"},
    "entities": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/entity_spec"}},
    "routes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/route_spec"}},
    "active_route_id": {"$ref": "common.schema.json#/$defs/slug"},
    "assumptions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "common.schema.json#/$defs/assumption"}},
    "provenance": {"enum": ["illustrative", "user_measured"]},
    "measurement_sources": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/measurement_source"}}
  },
  "$defs": {
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_mm", "depth_mm"],
      "properties": {
        "width_mm": {"type": "integer", "minimum": 5000, "maximum": 8000},
        "depth_mm": {"type": "integer", "minimum": 5000, "maximum": 8000}
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_mm", "z_mm", "yaw_deg"],
      "properties": {
        "x_mm": {"$ref": "common.schema.json#/$defs/coordinate_mm"},
        "z_mm": {"$ref": "common.schema.json#/$defs/coordinate_mm"},
        "yaw_deg": {"enum": [0, 90, 180, 270]}
      }
    },
    "entity_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "catalog_id", "role", "pose", "editable", "label"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "catalog_id": {"$ref": "common.schema.json#/$defs/slug"},
        "role": {"enum": ["payload", "blocker", "decoration"]},
        "pose": {"$ref": "#/$defs/pose"},
        "editable": {"type": "boolean"},
        "label": {"$ref": "common.schema.json#/$defs/label"}
      }
    },
    "waypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_mm", "z_mm"],
      "properties": {
        "x_mm": {"$ref": "common.schema.json#/$defs/coordinate_mm"},
        "z_mm": {"$ref": "common.schema.json#/$defs/coordinate_mm"}
      }
    },
    "route_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "payload_entity_id", "speed_mm_per_s", "waypoints"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/slug"},
        "label": {"$ref": "common.schema.json#/$defs/label"},
        "payload_entity_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "speed_mm_per_s": {"type": "integer", "minimum": 100, "maximum": 500},
        "waypoints": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/waypoint"}}
      }
    },
    "measurement_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_path", "source", "confirmed_at"],
      "properties": {
        "field_path": {"enum": ["room.width_mm", "room.depth_mm"]},
        "source": {"const": "user_confirmed"},
        "confirmed_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"}
      }
    }
  }
}
